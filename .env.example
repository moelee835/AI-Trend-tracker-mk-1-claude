# ============================================================
# AI Newsletter Service - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values

# --- Database ---
POSTGRES_DB=aitracker
POSTGRES_USER=aitracker
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql+asyncpg://aitracker:your_secure_password_here@localhost:5432/aitracker
# Sync URL for Alembic migrations
DATABASE_SYNC_URL=postgresql://aitracker:your_secure_password_here@localhost:5432/aitracker

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- LLM / AI ---
ANTHROPIC_API_KEY=sk-ant-your_key_here
OPENAI_API_KEY=sk-your_openai_key_here   # optional fallback

# --- News API ---
NEWS_API_KEY=your_newsapi_key_here           # https://newsapi.org
GNEWS_API_KEY=your_gnews_key_here            # https://gnews.io (optional)

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM_NAME=AI Trend Newsletter
SMTP_FROM_EMAIL=your_email@gmail.com

# --- Optional: SendGrid ---
# SENDGRID_API_KEY=your_sendgrid_key_here

# --- App Config ---
APP_ENV=development        # development | production
SECRET_KEY=your_secret_key_at_least_32_chars_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Scheduler ---
DAILY_COLLECT_HOUR=7       # 07:00 KST = UTC+9 → set UTC time accordingly
DAILY_COLLECT_MINUTE=0
DAILY_REPORT_HOUR=8
DAILY_REPORT_MINUTE=0
DAILY_SEND_HOUR=9
DAILY_SEND_MINUTE=0

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
